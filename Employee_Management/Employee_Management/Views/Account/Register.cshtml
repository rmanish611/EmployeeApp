@model Employee_Management.Models.RegisterViewModel



@{
    ViewBag.Title = "Register";
    Layout = null; // Fullscreen Netflix-style without default layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: url("https://assets.nflxext.com/ffe/siteui/vlv3/2a69ef5c-7a5d-4bcb-b1e5-cc5c8f7dcb14/e3a7168e-cd07-468f-a85e-48db911a7cba/IN-en-20230717-popsignuptwoweeks-perspective_alpha_website_large.jpg") no-repeat center center/cover;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .register-container {
            background: rgba(0,0,0,0.75);
            padding: 40px;
            border-radius: 12px;
            width: 350px;
            box-shadow: 0 0 20px rgba(0,0,0,0.8);
        }

            .register-container h2 {
                color: #fff;
                margin-bottom: 25px;
                text-align: center;
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group input {
                width: 100%;
                padding: 12px;
                border: none;
                border-radius: 6px;
                background: #333;
                color: #fff;
                font-size: 15px;
            }

                .form-group input:focus {
                    outline: none;
                    background: #444;
                }

        .btn-register {
            width: 100%;
            padding: 12px;
            background: #e50914;
            border: none;
            border-radius: 6px;
            color: #fff;
            font-size: 16px;
            cursor: pointer;
            font-weight: bold;
        }

            .btn-register:hover {
                background: #f6121d;
            }

        .extra-links {
            margin-top: 15px;
            text-align: center;
        }

            .extra-links a {
                color: #bbb;
                text-decoration: none;
                font-size: 14px;
            }

                .extra-links a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="register-container">
        <h2>Create Account</h2>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <input asp-for="Username" placeholder="Username" required />
            </div>
            <div class="form-group">
                <input asp-for="Email" type="email" placeholder="Email Address" required />
            </div>
            <div class="form-group">
                <input asp-for="Password" type="password" placeholder="Password" required />
            </div>
            <div class="form-group">
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" required />
            </div>
            <div class="form-group">
                <label>
                    <input asp-for="IsAgree" type="checkbox" /> I agree to the Terms & Conditions
                </label>
                <span asp-validation-for="IsAgree" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-register">Register</button>
        </form>

        <div class="extra-links">
            <a asp-action="Login">Already have an account? Sign In</a>
        </div>
    </div>
</body>
</html>

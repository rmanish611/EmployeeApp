@model Employee_Management.Models.LoginModel

@{
    ViewBag.Title = "Login";
    Layout = null; // Fullscreen Netflix-style
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: url("https://assets.nflxext.com/ffe/siteui/vlv3/2a69ef5c-7a5d-4bcb-b1e5-cc5c8f7dcb14/e3a7168e-cd07-468f-a85e-48db911a7cba/IN-en-20230717-popsignuptwoweeks-perspective_alpha_website_large.jpg") no-repeat center center/cover;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-container {
            background: rgba(0,0,0,0.75);
            padding: 40px;
            border-radius: 12px;
            width: 350px;
            box-shadow: 0 0 20px rgba(0,0,0,0.8);
        }

            .login-container h2 {
                color: #fff;
                margin-bottom: 25px;
                text-align: center;
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group input {
                width: 100%;
                padding: 12px;
                border: none;
                border-radius: 6px;
                background: #333;
                color: #fff;
                font-size: 15px;
            }

                .form-group input:focus {
                    outline: none;
                    background: #444;
                }

        .btn-login {
            width: 100%;
            padding: 12px;
            background: #e50914;
            border: none;
            border-radius: 6px;
            color: #fff;
            font-size: 16px;
            cursor: pointer;
            font-weight: bold;
        }

            .btn-login:hover {
                background: #f6121d;
            }

        .extra-links {
            margin-top: 15px;
            text-align: center;
        }

            .extra-links a {
                color: #bbb;
                text-decoration: none;
                font-size: 14px;
            }

                .extra-links a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="login-container">
        <h2>Sign In</h2>

        <form asp-action="Login" method="post">
            <div class="form-group">
                <input asp-for="Email" type="email" placeholder="Email Address" required />
            </div>
            <div class="form-group">
                <input asp-for="Password" type="password" placeholder="Password" required />
            </div>

            <button type="submit" class="btn-login">Login</button>
        </form>

        <div class="extra-links">
            <a asp-action="Register">Don't have an account? Sign Up</a>
        </div>
    </div>
</body>
</html>
